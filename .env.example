# Copy to .env and fill in. .env is gitignored - never commit secrets.
# Phase 3 backend admin token: required for all /api/admin/* endpoints.
# Generate one, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# Phase 6 buyback bot (live mode ONLY - everything here is gitignored).
# Mock mode is the default: leave these unset and the bot simulates swaps
# locally (dry_run=true burn rows) with zero network calls.
# To go live, the owner must BOTH set these AND flip buyback_live on
# (env ARENA_BUYBACK_LIVE=1 or via admin settings).
TREASURY_WALLET=<base58 pubkey of the bot's hot wallet>
TREASURY_PRIVATE_KEY=<base58 secret key of the hot wallet, keep it SMALL (hot/cold split)>
TEAM_WALLET=<base58 pubkey for team sweeps, only needed when team_sweep_enabled>
HELIUS_API_KEY=<helius key, reuses the RugRadar key>
# ARENA_BUYBACK_LIVE=1   # <- the explicit opt-in; default false (mock)

# Phase 1 (FT economy). All economic numbers are admin-configurable at
# runtime via /api/admin/settings; the ARENA_* env vars below are optional
# overrides. Payments are MOCK by default (nothing moves) until each live
# flag is explicitly flipped on by the owner.
# ARENA_BORN_FEE_SOL=0.1
# ARENA_BORN_SEASON_PCT=50
# ARENA_ENTRY_FEE_SOL=0.02
# ARENA_ENTRY_PRIZE_PCT=80
# ARENA_ENTRY_SEASON_PCT=20
# ARENA_OFFICIAL_BATTLE_INTERVAL_MINUTES=5
# ARENA_ENTRY_WINDOW_MINUTES=2
# ARENA_SEASON_LENGTH_DAYS=15
# ARENA_SEASON_PRIZE_1_PCT=60
# ARENA_SEASON_PRIZE_2_PCT=25
# ARENA_SEASON_PRIZE_3_PCT=15
# Official-battle scheduler: OFF by default. Set to 1 to run scheduled
# official battles (duel/royale alternating) in this process.
# ARENA_OFFICIAL_SCHEDULER=1
# Live-money opt-ins (each needs treasury + Helius configured first):
# ARENA_BORN_LIVE=1    # users pay the born fee in SOL from their wallet
# ARENA_ENTRY_LIVE=1   # owners pay the battle entry fee in SOL
# ARENA_PAYOUTS_LIVE=1 # IN-HOUSE ONLY: battle/season prizes paid in SOL
#                      # from the treasury hot wallet automatically
